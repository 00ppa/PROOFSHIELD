# Local ProofShield configuration. Keep real values outside the repository.
PROOFSHIELD_STORAGE_BACKEND=memory
PROOFSHIELD_SQLITE_PATH=proofshield.db

# Optional deployment-wide API protection. Unset for trusted local development.
PROOFSHIELD_API_TOKEN=

# Required to unlock controlled execution routes.
PROOFSHIELD_EXEC_TOKEN=

# Elasticsearch (choose one telemetry source for an assurance run).
PROOFSHIELD_ELASTIC_ENABLED=false
PROOFSHIELD_ELASTIC_URL=
PROOFSHIELD_ELASTIC_API_KEY=
PROOFSHIELD_ELASTIC_INDEX=.alerts-security.alerts-*
PROOFSHIELD_ELASTIC_TELEMETRY_INDEX=logs-*

# Splunk.
PROOFSHIELD_SPLUNK_ENABLED=false
PROOFSHIELD_SPLUNK_URL=
PROOFSHIELD_SPLUNK_TOKEN=
PROOFSHIELD_SPLUNK_TELEMETRY_INDEX=main
PROOFSHIELD_SPLUNK_ALERT_INDEX=alerts
PROOFSHIELD_SPLUNK_VERIFY_TLS=true
